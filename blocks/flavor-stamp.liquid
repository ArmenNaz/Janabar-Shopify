{%- liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

<div
  class="flavor-stamp-block flavor-stamp-block--{{ block.settings.alignment }} spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {% render 'flavor-origin', product: product_resource, size: block.settings.size %}
  {%- if block.settings.ingredient_count > 0 -%}
    {%- liquid
      capture stamp_ing
        render 'ingredient-list', handle: product_resource.handle, product: product_resource
      endcapture
      assign stamp_ing = stamp_ing | strip | split: ','
    -%}
    {%- if stamp_ing.size > 0 -%}
      <span class="flavor-stamp-block__ingredients flavor-stamp-block__ingredients--{{ block.settings.size }}">
        {%- for key in stamp_ing limit: block.settings.ingredient_count -%}
          {%- render 'ingredient-img', key: key, img_class: 'flavor-stamp-block__ingredient' -%}
        {%- endfor -%}
      </span>
    {%- endif -%}
  {%- endif -%}
</div>


{% schema %}
{
  "name": "Flavor stamp",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the passport stamp for this bar's destination. Set custom.origin_place, custom.origin_country, custom.origin_code and custom.stamp_color metafields to override."
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "range",
      "id": "ingredient_count",
      "label": "Ingredient illustrations",
      "info": "How many ingredient drawings to show beside the stamp (0 to hide).",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Flavor stamp"
    }
  ]
}
{% endschema %}
