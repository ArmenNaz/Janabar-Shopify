{%- comment -%}
  Our Story: image beside the brand story, with an optional row of stats.
  Blocks: paragraph (story text), stat (number + label).
{%- endcomment -%}

{%- liquid
  assign paragraphs = section.blocks | where: 'type', 'paragraph'
  assign stats = section.blocks | where: 'type', 'stat'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="our-story"
  class="section section--page-width color-{{ section.settings.color_scheme }} our-story our-story--image-{{ section.settings.image_position }}"
  style="--os-pad-top: {{ section.settings.padding-block-start }}px; --os-pad-bottom: {{ section.settings.padding-block-end }}px;"
>
  <div class="our-story__inner">
    <div class="our-story__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'our-story__image',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'our-story__image our-story__placeholder' }}
      {%- endif -%}
      {%- if section.settings.caption != blank -%}
        <p class="our-story__caption">{{ section.settings.caption }}</p>
      {%- endif -%}
    </div>

    <div class="our-story__copy">
      {%- if section.settings.label != blank -%}
        <p class="our-story__label">{{ section.settings.label }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2 our-story__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- for block in paragraphs -%}
        <div class="our-story__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- endfor -%}

      {%- if stats.size > 0 -%}
        <dl class="our-story__stats">
          {%- for block in stats -%}
            <div class="our-story__stat" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label }}</dt>
              <dd>{{ block.settings.value }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="button-secondary our-story__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Our story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Image caption" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "label", "label": "Small label", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every bar starts with a journey" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the flavors" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Number or short value", "default": "16g" },
        { "type": "text", "id": "label", "label": "Label", "default": "Protein per bar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our story",
      "blocks": [
        { "type": "paragraph" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
