      "blocks": {
        "paragraph_1": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Janabar started with a simple idea: the best flavors are the ones you find along the way. Every bar is built around a place, from the street stalls of Bangkok to the tea gardens of Assam and the autumn harvest of Armenia.</p>"
          }
        },
        "paragraph_2": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Each one packs 16 grams of protein, so it's as ready for a mountain trail as it is for a long day at your desk.</p>"
