{%- comment -%}
  Renders a passport-style "flavor stamp" for a Janabar bar.

  Accepts:
  - product: {product} the bar (optional if `handle` is given)
  - handle: {string} product handle (optional)
  - size: {string} 'sm' | 'md' | 'lg' (default 'md')
  - index: {number} stamp number shown on the stamp (optional)

  Destination data lives below, keyed by product handle. To override it
  without editing code, add product metafields:
    custom.origin_place, custom.origin_country, custom.origin_code,
    custom.stamp_color (color)

  Usage:
  {% render 'flavor-origin', product: product, size: 'sm' %}
{%- endcomment -%}

{%- liquid
  assign stamp_handle = handle | default: product.handle
  assign place = ''
  assign country = ''
  assign code = ''
  assign color = '#a42325'

  case stamp_handle
    when 'thai-chili-lime'
      assign place = 'Bangkok'
      assign country = 'Thailand'
      assign code = 'BKK'
      assign color = '#4f7a28'
    when 'assam-chai-spice'
      assign place = 'Assam'
      assign country = 'India'
      assign code = 'ASM'
      assign color = '#8a5a2b'
    when 'armenian-pumpkin'
      assign place = 'Yerevan'
      assign country = 'Armenia'
      assign code = 'EVN'
      assign color = '#c2611f'
    when 'mediterranean-spice'
      assign place = 'Mediterranean'
      assign country = 'Coast'
      assign code = 'MED'
      assign color = '#2f6f8f'
    when 'pueblo-mole'
      assign place = 'Puebla'
      assign country = 'Mexico'
      assign code = 'PBC'
      assign color = '#7a2e1f'
    when 'valencia-chocolate-orange'
      assign place = 'Valencia'
      assign country = 'Spain'
      assign code = 'VLC'
      assign color = '#d9771e'
  endcase

  if product.metafields.custom.origin_place != blank
    assign place = product.metafields.custom.origin_place.value
  endif
  if product.metafields.custom.origin_country != blank
    assign country = product.metafields.custom.origin_country.value
  endif
  if product.metafields.custom.origin_code != blank
    assign code = product.metafields.custom.origin_code.value
  endif
  if product.metafields.custom.stamp_color != blank
    assign color = product.metafields.custom.stamp_color.value
  endif

  assign stamp_size = size | default: 'md'
-%}

{%- if place != blank -%}
  <span
    class="flavor-stamp flavor-stamp--{{ stamp_size }}"
    style="--stamp-color: {{ color }};"
    aria-label="{{ place }}, {{ country }}"
  >
    <span class="flavor-stamp__top">Janabar · Passport</span>
    <span class="flavor-stamp__place">{{ place }}</span>
    <span class="flavor-stamp__country">{{ country }}</span>
    <span class="flavor-stamp__meta">
      <span>{{ code }}</span>
      {%- if index -%}
        <span>No. {{ index | prepend: '0' | slice: -2, 2 }}</span>
      {%- endif -%}
    </span>
  </span>
{%- endif -%}

