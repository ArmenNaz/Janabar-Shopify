{%- comment -%}
  Renders a passport-style "flavor stamp" for a Janabar bar.

  Accepts:
  - product: {product} the bar (optional if `handle` is given)
  - handle: {string} product handle (optional)
  - size: {string} 'sm' | 'md' | 'lg' (default 'md')
  - index: {number} stamp number shown on the stamp (optional)

  Destination data lives in snippets/flavor-data.liquid (with metafield
  overrides documented there).

  Usage:
  {% render 'flavor-origin', product: product, size: 'sm' %}
{%- endcomment -%}

{%- liquid
  assign stamp_handle = handle | default: product.handle
  capture stamp_data
    render 'flavor-data', handle: stamp_handle, product: product
  endcapture
  assign stamp_data = stamp_data | strip | split: '|'
  assign place = stamp_data[0]
  assign country = stamp_data[1]
  assign code = stamp_data[2]
  assign color = stamp_data[3] | default: '#a42325'
  assign stamp_size = size | default: 'md'
-%}

{%- if place != blank -%}
  <span
    class="flavor-stamp flavor-stamp--{{ stamp_size }}"
    style="--stamp-color: {{ color }};"
    aria-label="{{ place }}, {{ country }}"
  >
    <span class="flavor-stamp__top">Janabar · Passport</span>
    <span class="flavor-stamp__place">{{ place }}</span>
    <span class="flavor-stamp__country">{{ country }}</span>
    <span class="flavor-stamp__meta">
      <span>{{ code }}</span>
      {%- if index -%}
        <span>No. {{ index | prepend: '0' | slice: -2, 2 }}</span>
      {%- endif -%}
    </span>
  </span>
{%- endif -%}
